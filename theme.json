{
  "name": "Monitor M",
  "short": "jikasei",
  "description": "Monitor 第三方主题，提供节点地图、五种列表布局、资源与延迟图表、月度预算和到期提醒。",
  "version": "1.41.2",
  "author": "mghts · 原作 akanotanin",
  "url": "https://github.com/mghts/monitor-theme-jikasei",
  "config": [
    {
      "type": "title",
      "label": "列表与卡片"
    },
    {
      "type": "boolean",
      "key": "globeOn",
      "label": "节点地球",
      "default": true,
      "help": "显示节点地图与地区列表，支持 3D / 2D 切换。关闭后隐藏整个区域及顶栏开关；开启时访客可自行隐藏。"
    },
    {
      "type": "text",
      "key": "mapFlowCenterId",
      "label": "地图流向中心节点 ID",
      "default": "",
      "help": "填写主题中中心节点详情 /node/ 后的数字 ID。留空关闭。连线示意各地点向该节点汇聚，光点不代表实测流量。"
    },
    {
      "type": "select",
      "key": "listTop",
      "label": "列表页顶部",
      "default": "bothBudget",
      "options": [
        {
          "value": "none",
          "label": "都不显示"
        },
        {
          "value": "groups",
          "label": "只显示分组标签"
        },
        {
          "value": "summary",
          "label": "只显示概览卡片·原版"
        },
        {
          "value": "budget",
          "label": "只显示概览卡片·计费版"
        },
        {
          "value": "both",
          "label": "两个都显示·概览卡片原版"
        },
        {
          "value": "bothBudget",
          "label": "两个都显示·概览卡片计费版"
        }
      ],
      "help": "选择分组标签和概览卡片的显示方式。计费版包含月度预算、最近到期节点和 7 天内到期台数。"
    },
    {
      "type": "select",
      "key": "cardStyle",
      "label": "卡片形态",
      "default": "detailed",
      "options": [
        {
          "value": "classic",
          "label": "经典：网络速率与总量分两行，延迟在浮层中显示"
        },
        {
          "value": "plain",
          "label": "简约：网络数据合并为一行，不含延迟"
        },
        {
          "value": "latency",
          "label": "延迟：简约布局，附三网延迟"
        },
        {
          "value": "detailed",
          "label": "详细：包含延迟、在线时长、价格与到期信息"
        },
        {
          "value": "compact",
          "label": "紧凑：每行一个节点，可展开延迟图"
        }
      ],
      "help": "设置默认布局，访客可在顶栏自行切换。"
    },
    {
      "type": "title",
      "label": "节点信息"
    },
    {
      "type": "select",
      "key": "remarkPlacement",
      "label": "备注显示位置",
      "default": "both",
      "options": [
        {
          "value": "both",
          "label": "卡片与详情页都显示"
        },
        {
          "value": "card",
          "label": "只在卡片上显示"
        },
        {
          "value": "detail",
          "label": "只在整页详情里显示"
        },
        {
          "value": "none",
          "label": "都不显示"
        }
      ],
      "help": "在后台节点中填写备注，逗号分隔为多个标签，留空不显示。公开备注对访客可见，私有备注仅管理员可见。"
    },
    {
      "type": "text",
      "key": "pingLines",
      "label": "显示的延迟线路",
      "default": "",
      "help": "每行一个 ping 任务名，最多三条；留空自动取前三条。"
    },
    {
      "type": "select",
      "key": "latencyStyle",
      "label": "延迟曲线样式",
      "default": "broken",
      "options": [
        {
          "value": "broken",
          "label": "折线，保留断点（默认）"
        },
        {
          "value": "connected",
          "label": "连续折线"
        },
        {
          "value": "smooth",
          "label": "平滑曲线，保留断点"
        },
        {
          "value": "connectedSmooth",
          "label": "连续平滑曲线"
        }
      ],
      "help": "统一首页卡片、浮层、紧凑展开与节点详情的默认线形；仅影响显示，不改变丢包或无响应数据。"
    },
    {
      "type": "title",
      "label": "预算与汇率"
    },
    {
      "type": "text",
      "key": "exchangeRates",
      "label": "自定义汇率",
      "default": "",
      "help": "可选，留空自动获取最新每日参考价。每行 CODE=人民币汇率，例如 USD=7.1；代表1单位该币种等于多少人民币。自定义值优先，可补充无公开报价的币种。"
    },
    {
      "type": "title",
      "label": "外观"
    },
    {
      "type": "boolean",
      "key": "gruvboxOn",
      "label": "Gruvbox 配色",
      "default": false,
      "help": "启用暖灰暗色与米纸亮色配色。明暗仍由主题模式和访客偏好决定。"
    },
    {
      "type": "select",
      "key": "themeMode",
      "label": "主题模式",
      "default": "system",
      "options": [
        {
          "value": "system",
          "label": "随系统设置"
        },
        {
          "value": "auto",
          "label": "随北京时间自动切换"
        },
        {
          "value": "light",
          "label": "亮色"
        },
        {
          "value": "dark",
          "label": "暗色"
        }
      ],
      "help": "设置站点明暗。自动模式按北京时间 19:00–07:00 使用暗色；访客可自行切换。"
    }
  ]
}
